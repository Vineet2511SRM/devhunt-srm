# ============================================================
# DevHunt SRM — Server Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/devhunt-srm

# Authentication & JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Frontend CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage (Image Uploads) — https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP)
# Free options: Brevo (300/day), Mailtrap (dev), Resend (100/day)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@devhunt-srm.edu
FROM_NAME="DevHunt SRM"

# Google OAuth 2.0 — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redis (Rate Limiting — optional for dev, required for production)
# REDIS_URL=redis://default:password@host:6379
